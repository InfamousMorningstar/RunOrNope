<Application x:Class="RunOrNope.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#17202A"/>
    <SolidColorBrush x:Key="SlateBrush" Color="#34495E"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#F3F7FA"/>
    <SolidColorBrush x:Key="EvidenceBrush" Color="#C47A16"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="#A93226"/>
    <SolidColorBrush x:Key="VerifiedBrush" Color="#24756A"/>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
  </Application.Resources>
</Application>
