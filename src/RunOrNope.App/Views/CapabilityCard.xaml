<UserControl x:Class="RunOrNope.App.Views.CapabilityCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{Binding Title}">
  <Border BorderBrush="#CBD5DE" BorderThickness="1" CornerRadius="4"
          Background="White" Padding="18" Margin="0,0,0,12">
    <StackPanel>
      <TextBlock Text="{Binding ContextLabel}" Foreground="{StaticResource EvidenceBrush}"
                 FontWeight="Bold" FontSize="12"/>
      <TextBlock Text="{Binding Title}" Foreground="{StaticResource InkBrush}"
                 FontFamily="Segoe UI Variable Display" FontWeight="SemiBold"
                 FontSize="20" Margin="0,4,0,6" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding PotentialImpact}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <UniformGrid Columns="3" Margin="0,0,0,10">
        <TextBlock Text="{Binding Severity, StringFormat=Severity: {0}}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding EvidenceStatus, StringFormat=Evidence: {0}}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding EvidenceConfidence, StringFormat=Confidence: {0}}"/>
        <TextBlock Text="{Binding ParserConfidence, StringFormat=Parser: {0}}"/>
        <TextBlock Text="{Binding Reachability, StringFormat=Reachability: {0}}"/>
        <TextBlock Text="{Binding ApplicationLinkage, StringFormat=Attribution: {0}}"/>
        <TextBlock Text="{Binding Family, StringFormat=Family: {0}}"/>
      </UniformGrid>
      <TextBlock Text="{Binding RecommendedAction, StringFormat=Recommended action: {0}}"
                 FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Exact sources" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding Sources}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Benign explanations" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <ItemsControl ItemsSource="{Binding BenignExplanations}"/>
      <TextBlock Text="Limitations" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <ItemsControl ItemsSource="{Binding Limitations}"/>
    </StackPanel>
  </Border>
</UserControl>
